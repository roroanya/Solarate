# Salin file ini jadi .env lalu isi token TMDB kamu
TMDB_READ_TOKEN=isi_read_access_token_di_sini
# Opsional: dipakai kalau READ_TOKEN kosong
TMDB_API_KEY=

DEFAULT_LANGUAGE=en-US
DEFAULT_REGION=ID
CACHE_TTL_SECONDS=600

# Default: poster diambil langsung dari TMDB.
# Kalau image.tmdb.org diblokir ISP, ganti ke proxy backend, contoh emulator:
# IMAGE_BASE_URL=http://10.0.2.2:8000/img
IMAGE_BASE_URL=https://image.tmdb.org/t/p
