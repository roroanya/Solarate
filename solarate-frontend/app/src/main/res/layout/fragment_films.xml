<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/lb_black">

    <!-- 1. HEADER / TOP BAR (MENGGUNAKAN LOGO_HEADER) -->
    <ImageView
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:src="@drawable/logo_header"
        android:scaleType="fitCenter" />

    <!-- 2. TAB LAYOUT -->
    <com.google.android.material.tabs.TabLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/lb_black"
        app:tabIndicatorColor="@color/lb_green"
        app:tabSelectedTextColor="@color/white"
        app:tabTextColor="@color/lb_gray"
        app:tabMode="fixed"
        app:tabGravity="fill">

        <com.google.android.material.tabs.TabItem android:text="Films" />
        <com.google.android.material.tabs.TabItem android:text="Reviews" />
        <com.google.android.material.tabs.TabItem android:text="Lists" />
        <com.google.android.material.tabs.TabItem android:text="Journal" />
    </com.google.android.material.tabs.TabLayout>

    <!-- Garis pemisah tipis -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/lb_dark" />

    <!-- 3. SECTION HEADER -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Popular this week"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp" />

    <!-- 4. RECYCLER VIEW (GRID FILM) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMovies"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingBottom="12dp" />

</LinearLayout>