<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lb_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. TOP BAR & TABS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="16dp" />

        <!-- TAMBAHAN ID: profileTabs -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/profileTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/lb_black"
            app:tabIndicatorColor="@color/lb_green"
            app:tabSelectedTextColor="@color/white"
            app:tabTextColor="@color/lb_gray"
            app:tabMode="fixed"
            app:tabGravity="fill">
            <com.google.android.material.tabs.TabItem android:text="Profile" />
            <com.google.android.material.tabs.TabItem android:text="Diary" />
            <com.google.android.material.tabs.TabItem android:text="Lists" />
            <com.google.android.material.tabs.TabItem android:text="Watchlist" />
        </com.google.android.material.tabs.TabLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/lb_dark" />

        <!-- 2. HEADER PROFIL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingVertical="24dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/logo_solarate"
                android:background="@drawable/bg_pro_badge"
                android:backgroundTint="@color/lb_dark"
                android:padding="12dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvProfileUsernameHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="username"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Bintang & Angka -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_star"
                    app:tint="@color/lb_green" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" 20"
                    android:textColor="@color/lb_gray"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="here's my museum of movies"
                android:textColor="@color/lb_gray"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 3. FAVORITES SECTION -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FAVORITES"
            android:textColor="@color/lb_gray"
            android:textSize="12sp"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="8dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:scrollbars="none"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <!-- Placeholder Gambar 1 (TAMBAHAN ID: ivFav1) -->
                <ImageView
                    android:id="@+id/ivFav1"
                    android:layout_width="90dp" android:layout_height="135dp"
                    android:scaleType="centerCrop" android:background="@color/lb_dark"
                    android:layout_marginEnd="8dp" />
                <!-- Placeholder Gambar 2 (TAMBAHAN ID: ivFav2) -->
                <ImageView
                    android:id="@+id/ivFav2"
                    android:layout_width="90dp" android:layout_height="135dp"
                    android:scaleType="centerCrop" android:background="@color/lb_dark"
                    android:layout_marginEnd="8dp" />
                <!-- Placeholder Gambar 3 (TAMBAHAN ID: ivFav3) -->
                <ImageView
                    android:id="@+id/ivFav3"
                    android:layout_width="90dp" android:layout_height="135dp"
                    android:scaleType="centerCrop" android:background="@color/lb_dark"
                    android:layout_marginEnd="8dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 4. RECENT ACTIVITY SECTION -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RECENT ACTIVITY"
            android:textColor="@color/lb_gray"
            android:textSize="12sp"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="8dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:scrollbars="none"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <!-- Placeholder Gambar Recent 1 (TAMBAHAN ID: ivRecent1) -->
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="8dp">
                    <ImageView
                        android:id="@+id/ivRecent1"
                        android:layout_width="90dp" android:layout_height="135dp" android:scaleType="centerCrop" android:background="@color/lb_dark" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="★★★★☆" android:textColor="@color/lb_green" android:textSize="10sp" android:layout_marginTop="4dp"/>
                </LinearLayout>
                <!-- Placeholder Gambar Recent 2 (TAMBAHAN ID: ivRecent2) -->
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="8dp">
                    <ImageView
                        android:id="@+id/ivRecent2"
                        android:layout_width="90dp" android:layout_height="135dp" android:scaleType="centerCrop" android:background="@color/lb_dark" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="★★★☆☆" android:textColor="@color/lb_green" android:textSize="10sp" android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 5. STATS LIST (DAFTAR MENU) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- Item 1 (Films): TAMBAHAN ID: rowFilms -->
            <LinearLayout
                android:id="@+id/rowFilms"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"> <!-- Efek klik -->

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Films" android:textColor="@color/lb_gray" android:textSize="14sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="144 / 97 this year" android:textColor="@color/lb_gray" android:textSize="14sp" android:layout_marginEnd="8dp"/>
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_arrow_right" app:tint="@color/lb_gray"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/lb_dark" />

            <!-- Item 2 (Reviews): TAMBAHAN ID: rowReviews -->
            <LinearLayout
                android:id="@+id/rowReviews"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"> <!-- Efek klik -->

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Reviews" android:textColor="@color/lb_gray" android:textSize="14sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="23" android:textColor="@color/lb_gray" android:textSize="14sp" android:layout_marginEnd="8dp"/>
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_arrow_right" app:tint="@color/lb_gray"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/lb_dark" />

            <!-- Item 3 (Watchlist): TAMBAHAN ID: rowWatchlist -->
            <LinearLayout
                android:id="@+id/rowWatchlist"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"> <!-- Efek klik -->

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Watchlist" android:textColor="@color/lb_gray" android:textSize="14sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="48" android:textColor="@color/lb_gray" android:textSize="14sp" android:layout_marginEnd="8dp"/>
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_arrow_right" app:tint="@color/lb_gray"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Jarak sebelum tombol sign out -->
        <View android:layout_width="match_parent" android:layout_height="32dp" />

        <!-- 6. TOMBOL SIGN OUT (HIJAU) -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="24dp"
            android:text="Sign Out"
            android:textColor="@color/lb_black"
            android:backgroundTint="@color/lb_green"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>